# =============================================================================
# Environment template — copy to .env for shared defaults.
# Put API keys in .env.development (loaded by `next dev` and overrides .env).
# =============================================================================

NODE_ENV=development

# Postgres local (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pequenos_discipulos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pequenos_discipulos

# Dev auth (seed user id — must match prisma seed)
DEV_USER_ID=dev-user-1

# YouVersion Bible API (server-only) — empty uses stub
YVP_APP_KEY=
# Default Portuguese bible on the YouVersion Platform (Bíblia Livre Para Todos)
YVP_DEFAULT_BIBLE_VERSION_ID=3254
# Set YVP_USE_STUB=true to force stub even with a key
YVP_USE_STUB=

# LLM (server-only) — empty uses stub
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Set LLM_USE_STUB=true to force stub even with a key
LLM_USE_STUB=

# ElevenLabs audio (server-only) — empty voice id or TTS_USE_STUB uses silent stub
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_TTS_VOICE_ID=
# Free plan: use a default/premade voice from your ElevenLabs account (not Voice Library-only voices).
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v2
# Set TTS_USE_STUB=true to force silent stub even with a key
TTS_USE_STUB=
