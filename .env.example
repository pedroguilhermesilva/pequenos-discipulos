# =============================================================================
# Environment template — copy to .env for shared defaults.
# Put secrets in .env.local (loaded by Next.js and overrides .env).
# =============================================================================

NODE_ENV=development

# Postgres (local docker compose or Neon)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pequenos_discipulos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pequenos_discipulos
# Neon migrations / prisma db push (direct connection, not pooled)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/pequenos_discipulos

# Auth.js / NextAuth (required in production)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (optional — omit both to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# LLM (server-only) — empty uses stub
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_USE_STUB=
# json_schema (OpenAI Structured Outputs, padrão em api.openai.com) ou json_object (outros provedores)
LLM_RESPONSE_FORMAT=

# OpenAI moderation (optional — falls back to LLM_API_KEY / LLM_BASE_URL)
# Use a project key with /moderations access when LLM_API_KEY is restricted.
OPENAI_MODERATION_API_KEY=
OPENAI_MODERATION_BASE_URL=

# Google Cloud TTS (server-only) — narração. Autenticação SÓ por conta de serviço (service account).
# JSON completo da chave da conta de serviço (client_email + private_key + project_id); pode ser colado cru, em várias linhas.
# A conta precisa do papel "Usuário da Plataforma de Agentes" (roles/aiplatform.user) no projeto dela.
# Sem este valor (e sem TTS_USE_STUB=true) a narração mostra "Narração não configurada: falta GOOGLE_TTS_CREDENTIALS_JSON".
GOOGLE_TTS_CREDENTIALS_JSON=
# Opcional: projeto de faturação/quota. Sem ele usa o project_id do JSON.
GOOGLE_CLOUD_PROJECT_ID=
# Provider: gemini (default, Gemini Flash TTS) or neural2 (Neural2/WaveNet with SSML timepoints)
GOOGLE_TTS_PROVIDER=gemini
GOOGLE_TTS_MODEL=gemini-2.5-flash-tts
GOOGLE_TTS_GEMINI_VOICE=Leda
GOOGLE_TTS_STYLE_PROMPT=Você é uma narradora calorosa e expressiva contando uma história bíblica para crianças em português do Brasil. Fale com ritmo calmo, entonação suave e emoção natural nos diálogos.
# Neural2 fallback (when GOOGLE_TTS_PROVIDER=neural2)
GOOGLE_TTS_VOICE=pt-BR-Neural2-C
GOOGLE_TTS_LANGUAGE=pt-BR
# Word alignment after Gemini synthesis. Recomendado: groq (Whisper, ~US$0,003/história) + GROQ_API_KEY.
# google = Speech-to-Text v2 com a mesma conta de serviço (precisa da API Speech-to-Text ativada).
NARRATION_ALIGNER=groq
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# true = áudio silencioso local (dev/e2e), sem chamar o Google
TTS_USE_STUB=

# ElevenLabs SFX (server-only) — efeitos sonoros; removido totalmente no issue #5
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v2

# Rate limit (optional — Upstash Redis in production; in-memory fallback in dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — private store pequenos-discipulos-audio (fra1)
# When set, audio is stored in Blob; omit for local ./storage fallback
BLOB_READ_WRITE_TOKEN=
